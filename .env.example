# Copy to .env.local for local development. Every value is optional.

# Public URL used for canonical links, sitemap and Open Graph tags.
# Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically, so you only need this
# once you connect a custom domain, e.g. https://arnavchachra.com
NEXT_PUBLIC_SITE_URL=

# Optional GitHub token (no scopes needed) to raise the API rate limit for the
# "Recently on GitHub" list. Server-only; never prefix it with NEXT_PUBLIC_.
GITHUB_TOKEN=
